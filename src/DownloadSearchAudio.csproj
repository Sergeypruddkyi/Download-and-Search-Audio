<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DownloadSearchAudio</AssemblyName>
    <RootNamespace>DownloadSearchAudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\DownloadSearchAudio.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>

    <Product>Download and Search Audio</Product>
    <AssemblyTitle>Download and Search Audio</AssemblyTitle>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>

    <!-- Portable self-contained win-x64 publish (same scheme as YouTubeDownloader-Net10). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Publishing)' == 'true'">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildProjectDirectory)\..\dist\DownloadSearchAudio\</PublishDir>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Code-first WinForms UI: no Designer files. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same icon embedded into the assembly so the window/taskbar pick it up
         at runtime without any external file dependency. -->
    <EmbeddedResource Include="..\Assets\DownloadSearchAudio.ico" LogicalName="DownloadSearchAudio.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

</Project>
